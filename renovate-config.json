{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for anynear repositories. Use it with extends: local>anynear/.github:renovate-config",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automerge": false,
  "platformCommit": "enabled",
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "rebaseWhen": "conflicted",
  "dependencyDashboardTitle": "Dependencies (Renovate)",
  "dependencyDashboardOSVVulnerabilitySummary": "none",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "prCreation": "immediate"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "One grouped pull request per ecosystem and week",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Gradle"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker"
    },
    {
      "description": "meshtastic-sdk is pinned on purpose; Kotlin and Kable are bound to its ABI. Only after approval in the dashboard.",
      "matchPackageNames": ["org.meshtastic:**", "org.jetbrains.kotlin**", "com.juul.kable:**"],
      "groupName": "meshtastic-sdk, Kotlin, Kable",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Go: keep indirect modules current, never raise the go directive of go.mod on its own",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    }
  ],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"]
}
